// ── Hybrid AOT/JIT Execution Example ────────────────────────────────────────
//
// This example demonstrates the two-tier AOT/JIT hybrid execution model:
//
//   Tier 1 (AOT): The get_mask function is compiled ahead-of-time with
//                 dynamic shapes. On first execution, it runs instantly
//                 using the AOT binary while the JIT profiles the shapes.
//
//   Tier 2 (JIT): After 10 executions with consistent shapes, the JIT
//                 compiles a specialized version with static shapes
//                 (tensor<4xf32>). Subsequent calls hit the fast Tier 2.
//
// Graph Collapsing: The get_mask function's output [1.0, 2.0, 3.0, 4.0] * 2.0
//                    is computed at compile time via SCCP and collapsed into
//                    a single dense constant [2.0, 4.0, 6.0, 8.0].
//                    The entire function is then eliminated by SymbolDCE.

get_mask : () -> [4]f32
get_mask () = [1.0, 2.0, 3.0, 4.0] * 2.0

linear : ([4]f32, [4,4]f32, [4]f32) -> [4]f32
linear (x, w, b) = x ** w + b

predict : ([4]f32) -> [4]f32
predict x =
  let M = get_mask()
  in let y = linear(x * M, w, b)
  in y
  where
    w = random([4,4]f32)
    b = zeros([4]f32)

main : () -> [4]f32
main () =
  let x = random([4]f32)
  in predict(x)
