// ── Autodiff with Graph Collapsing Example ─────────────────────────────────
//
// This example demonstrates how the graph collapsing engine interacts
// with the autodiff pass. After computing gradients:
//   - Identity gradients are pruned (e.g., grad of x+0 is just 1)
//   - Double transposes from matmul gradients are collapsed
//   - Zero gradient paths are eliminated entirely
//   - The resulting gradient computation is minimal

loss : ([32,784]f32, [784,10]f32, [32,10]f32) -> f32
loss (x, w, target) =
  let logits = x ** w
  in let diff = logits - target
  in mean(diff * diff)

train_step : ([32,784]f32, [784,10]f32, [32,10]f32) -> [784,10]f32
train_step (x, w, target) =
  let g = grad(loss, w)
  in w - 0.01 * g

main : () -> [784,10]f32
main () =
  let x = random([32,784]f32)
  in let w = random([784,10]f32)
  in let target = zeros([32,10]f32)
  in train_step(x, w, target)
