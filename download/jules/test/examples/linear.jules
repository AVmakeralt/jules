-- linear.jules
-- A single linear (dense) layer: Y = relu(X @ W + b)
-- This demonstrates tensor types with symbolic dimensions and matmul.

predict : [B, I]f32 -> [I, O]f32 -> [O]f32 -> [B, O]f32
predict X W b =
    let product = X ** W
    in relu(product + b)

-- Mean Squared Error loss function
loss_fn : [B, O]f32 -> [B, O]f32 -> []f32
loss_fn preds targets =
    mean((preds - targets) ^ 2)

main : () -> []f32
main () =
    let X = random([32, 784])
    let W = random([784, 10])
    let b = zeros([10])
    let Y = random([32, 10])
    let current_loss = loss_fn(predict(X, W, b), Y)
    let dW = grad(\W -> loss_fn(predict(X, W, b), Y), W)
    in current_loss
